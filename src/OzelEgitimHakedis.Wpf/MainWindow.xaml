<Window x:Class="OzelEgitimHakedis.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Özel Eğitim Hakediş Sistemi (OEHS)"
        Width="2168"
        Height="997"
        MinWidth="966"
        MinHeight="536"
        SizeToContent="Manual"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ShowInTaskbar="True"
        Background="{StaticResource Navy900Brush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        StateChanged="Window_StateChanged">
    <Viewbox x:Name="AppScaleViewbox"
             Stretch="Uniform"
             StretchDirection="DownOnly"
             HorizontalAlignment="Center"
             VerticalAlignment="Center">
        <Border Width="2234.1"
                Height="1095.2"
                CornerRadius="15"
                BorderBrush="#35546F"
                BorderThickness="1"
                Background="{StaticResource Navy900Brush}"
                Margin="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="82"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="290"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ÜST BAR -->
                <Grid Grid.Row="0" Grid.ColumnSpan="2"
                      Background="{StaticResource Navy900Brush}"
                      MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="25,0,0,0">
                        <TextBlock Text="OEHS" Foreground="White" FontSize="29" FontWeight="Bold"/>
                        <TextBlock Text="ÖZEL EĞİTİM HAKEDİŞ" Foreground="#B9CBDA" FontSize="10.5" FontWeight="SemiBold" Margin="1,1,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            Width="188"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="#092746"
                            CornerRadius="9"
                            BorderBrush="#24496B"
                            BorderThickness="1"
                            Padding="13,8"
                            Margin="18,0,0,0">
                        <StackPanel>
                            <TextBlock Text="KAYIT DURUMU" Foreground="#8FA8C0" FontSize="10" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <Ellipse Width="9" Height="9" Fill="#43C77A" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Hazır" Foreground="#DDF6E7" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Column="2" VerticalAlignment="Center" Margin="8,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="104"/>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#082744" BorderBrush="#24496B" BorderThickness="1" CornerRadius="9" Padding="12,7">
                            <StackPanel>
                                <TextBlock Text="AKTİF MODÜL" Foreground="#8FA8C0" FontSize="10" FontWeight="SemiBold"/>
                                <TextBlock x:Name="HeaderModuleText" Text="Ana Ekran" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,7,0">
                                <TextBlock Text="HAZIRLIK" Foreground="#8FA8C0" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                <TextBlock Text="DURUMU" Foreground="#C3CFDC" FontSize="10.5" HorizontalAlignment="Right"/>
                            </StackPanel>
                            <Grid Width="48" Height="48">
                                <Ellipse Stroke="#29445F" StrokeThickness="5"/>
                                <Path x:Name="HeaderReadinessArc"
                                      Stroke="#FFB41F"
                                      StrokeThickness="5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M24,4 A20,20 0 1 1 4,24"/>
                                <TextBlock x:Name="HeaderReadinessText"
                                           Text="%0"
                                           Foreground="White"
                                           FontSize="11.5"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                        <Border Grid.Column="3"
                                Background="#082744"
                                BorderBrush="#24496B"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="12,7">
                            <StackPanel>
                                <TextBlock Text="KAYIT DURUMU" Foreground="#8FA8C0" FontSize="10" FontWeight="SemiBold"/>
                                <TextBlock Text="Hazır" Foreground="#DDF6E7" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Button Grid.Column="4" Content="—" ToolTip="Küçült" FontSize="21" FontWeight="SemiBold"
                                Foreground="White" Background="Transparent" BorderThickness="0" Width="44" Height="48"
                                Cursor="Hand" Click="Minimize_Click"/>
                        <Button x:Name="MaximizeRestoreButton" Grid.Column="5" ToolTip="Tam ekran"
                                Foreground="White" Background="Transparent" BorderThickness="0" Width="44" Height="48"
                                Cursor="Hand" Click="MaximizeRestore_Click">
                            <TextBlock x:Name="MaximizeRestoreIcon" FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE922;" FontSize="15" FontWeight="SemiBold"/>
                        </Button>
                        <Button Grid.Column="6" Content="×" ToolTip="Kapat" FontSize="25" Foreground="White"
                                Background="Transparent" BorderThickness="0" Width="44" Height="48"
                                Cursor="Hand" Click="Close_Click"/>
                    </Grid>
                </Grid>

                <!-- SOL MENÜ -->
                <Grid Grid.Row="1" Grid.Column="0" Background="{StaticResource Navy900Brush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="92"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,6,0,0">
                        <Button x:Name="NavHome" Tag="Home" Uid="Active" Style="{StaticResource NavButton}" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" FontSize="23" Width="42"/>
                                <TextBlock Text="ANA EKRAN" FontSize="16.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Border Height="3" Background="#557A9D" Margin="16,10" CornerRadius="1.5"/>
                        <Button x:Name="NavContract" Style="{StaticResource NavButton}" Tag="Contract" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8D2;" FontSize="23" Width="42"/>
                                <TextBlock Text="İHALE BİLGİLERİ" FontSize="16.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavContractors" Style="{StaticResource NavButton}" Tag="Contractors" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70B;" FontSize="23" Width="42"/>
                                <TextBlock Text="YÜKLENİCİ FİRMALAR" FontSize="16.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavLines" Style="{StaticResource NavButton}" Tag="Lines" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" FontSize="23" Width="42"/>
                                <TextBlock Text="HATLAR" FontSize="16.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavProgress" Style="{StaticResource NavButton}" Tag="Progress" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D2;" FontSize="23" Width="42"/>
                                <TextBlock Text="HAKEDİŞ OLUŞTUR" FontSize="16.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Border Height="3" Background="#557A9D" Margin="16,10" CornerRadius="1.5"/>
                        <Button x:Name="NavReports" Style="{StaticResource NavButton}" Tag="Reports" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D2;" FontSize="23" Width="42"/>
                                <TextBlock Text="ÇIKTILAR" FontSize="16.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavHistory" Style="{StaticResource NavButton}" Tag="History" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE81C;" FontSize="23" Width="42"/>
                                <TextBlock Text="HAKEDİŞ GEÇMİŞİ" FontSize="16.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavAcceptance" Style="{StaticResource NavButton}" Tag="Acceptance" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A1;" FontSize="23" Width="42"/>
                                <TextBlock Text="KABUL TUTANAĞI" FontSize="16.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavArchives" Style="{StaticResource NavButton}" Tag="Archives" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8F4;" FontSize="23" Width="42"/>
                                <TextBlock Text="ARŞİVLER" FontSize="16.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="Settings" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="23" Width="42"/>
                                <TextBlock Text="AYARLAR" FontSize="16.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Border Grid.Row="1" Margin="18,7,18,10" Padding="14,9" CornerRadius="9" Background="#082845" BorderBrush="#73581E" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Created by" Foreground="#A8BCD0" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="Aşkın KESKİNBALTA" Foreground="{StaticResource Gold500Brush}" FontSize="16" FontWeight="Bold" Margin="0,2,0,0"/>
                            <Border Height="2" Width="74" Background="{StaticResource Gold500Brush}" HorizontalAlignment="Left" Margin="0,6,0,0" CornerRadius="1"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- İÇERİK -->
                <Border Grid.Row="1" Grid.Column="1" Background="White" CornerRadius="13,0,13,0" Padding="18">
                    <Grid>
                        <Grid x:Name="HomePanel">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                            <StackPanel>
                                <TextBlock Text="ÖZEL EĞİTİM HAKEDİŞ SİSTEMİ" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Hakediş sürecini sözleşmeden hesaplamaya kadar tek akışta yönetin." Style="{StaticResource PageSubtitle}"/>
                                <Border Style="{StaticResource PremiumPanel}" Padding="20" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="245"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="#1D4B70" CornerRadius="11" Padding="9,4" Margin="0,0,10,0">
                                                    <TextBlock Text="AKTİF İŞLEM" Foreground="#D9E9F6" FontSize="11" FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock Text="HAZIR" Foreground="{StaticResource Gold500Brush}" FontSize="11.5" FontWeight="Bold"/>
                                            </StackPanel>
                                            <TextBlock Text="Önce sözleşmeyi tanımlayın" Foreground="White" FontSize="23" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                            <TextBlock Text="İhale → Yüklenici → Hat → Hakediş → Çıktı akışı burada ilerleyecek." Foreground="#C5D7E7" FontSize="13" Margin="0,5,0,0"/>
                                            <Button Content="İHALE BİLGİLERİ TANIMLA" Tag="Contract" Click="NavigationButton_Click"
                                                    Style="{StaticResource ModernButton}" Width="275" Height="42"
                                                    HorizontalAlignment="Left" Margin="0,18,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#0A2A49" BorderBrush="#335A79" BorderThickness="1" CornerRadius="11" Padding="15,12" VerticalAlignment="Center">
                                            <StackPanel>
                                                <TextBlock Text="SİSTEM" Foreground="#91ABC0" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                <TextBlock Text="OEHS v0.5" Foreground="White" FontSize="21" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                                <Border Height="1" Background="#315371" Margin="0,11,0,9"/>
                                                <TextBlock Text="HESAPLAMA MOTORU" Foreground="#91ABC0" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                <TextBlock Text="HAZIR" Foreground="{StaticResource Gold500Brush}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                                                                                                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.8*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="AKTİF İHALE / DOSYA NO" Style="{StaticResource CardTitle}"/>
                                            <ComboBox x:Name="HomeTenderListBox"
                                                      Height="44"
                                                      Margin="0,7,10,0"
                                                      SelectionChanged="HomeTenderListBox_SelectionChanged"
                                                      Style="{StaticResource FieldComboBox}"
                                                      ToolTip="İhale / dosya numarasını seçin">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding TenderNumber}" FontSize="14" FontWeight="SemiBold"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#0A2A49" BorderBrush="#335A79" BorderThickness="1" CornerRadius="9" Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="SEÇİLEN İHALE ÖZETİ" Foreground="{StaticResource Gold500Brush}" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock x:Name="HomeSelectedTenderSummaryTextBlock" Text="İhale seçiniz." Foreground="White" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>                                <Grid Margin="0,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Padding="15" Margin="0,0,5,5">
                                        <StackPanel>
                                            <TextBlock Text="TAŞIMA HİZMETİ" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="Taşıma Hizmet" Style="{StaticResource FieldLabel}" Margin="0,7,0,0"/>
                                            <TextBlock x:Name="HomeTransportServiceTextBlock" Text="0,00 ₺" Foreground="White" FontSize="24" FontWeight="Bold"/>
                                            <TextBlock Text="Taşıma Fiyat Farkı" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="HomeTransportPriceDifferenceTextBlock" Text="0,00 ₺" Foreground="White" FontSize="19" FontWeight="SemiBold"/>
                                            <TextBlock Text="Taşıma Hakediş" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="HomeTransportNetTextBlock" Text="0,00 ₺" Foreground="White" FontSize="23" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Padding="15" Margin="2,0,3,5">
                                        <StackPanel>
                                            <TextBlock Text="REHBER HİZMETİ" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="Rehber Hizmet" Style="{StaticResource FieldLabel}" Margin="0,7,0,0"/>
                                            <TextBlock x:Name="HomeGuideServiceTextBlock" Text="0,00 ₺" Foreground="White" FontSize="24" FontWeight="Bold"/>
                                            <TextBlock Text="Rehber Hakediş" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="HomeGuideNetTextBlock" Text="0,00 ₺" Foreground="White" FontSize="23" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}" Padding="15" Margin="3,0,2,5">
                                        <StackPanel>
                                            <TextBlock Text="VERGİ &amp; TEVKİFAT" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="KDV" Style="{StaticResource FieldLabel}" Margin="0,7,0,0"/>
                                            <TextBlock x:Name="HomeVatTextBlock" Text="0,00 ₺" Foreground="White" FontSize="24" FontWeight="Bold"/>
                                            <TextBlock Text="KDV / Tevkifat" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="HomeVatWithholdingTextBlock" Text="0,00 / 0,00 ₺" Foreground="White" FontSize="19" FontWeight="SemiBold"/>
                                            <TextBlock Text="Tevkifat" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="HomeWithholdingTextBlock" Text="0,00 ₺" Foreground="White" FontSize="23" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource Card}" Padding="15" Margin="5,0,0,5">
                                        <StackPanel>
                                            <TextBlock Text="DİĞER KESİNTİLER" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="Damga Vergisi" Style="{StaticResource FieldLabel}" Margin="0,7,0,0"/>
                                            <TextBlock x:Name="HomeStampTaxTextBlock" Text="0,00 ₺" Foreground="White" FontSize="21" FontWeight="Bold"/>
                                            <TextBlock Text="Fiyat Farkı Teminatı" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="HomeGuaranteeTextBlock" Text="0,00 ₺" Foreground="White" FontSize="21" FontWeight="Bold"/>
                                            <TextBlock Text="Toplam Kesinti" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="HomeDeductionsTextBlock" Text="0,00 ₺" Foreground="White" FontSize="24" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Padding="15" Margin="0,5,5,0">
                                        <StackPanel>
                                            <TextBlock Text="TAHAKKUK" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="Toplam Tutar" Style="{StaticResource FieldLabel}" Margin="0,7,0,0"/>
                                            <TextBlock x:Name="HomeTotalAmountTextBlock" Text="0,00 ₺" Foreground="White" FontSize="25" FontWeight="Bold"/>
                                            <TextBlock Text="Fatura Tutarı" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="HomeInvoiceTextBlock" Text="0,00 ₺" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                            <TextBlock Text="Brüt Tutar" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="HomeGrossTextBlock" Text="0,00 ₺" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="15" Margin="2,5,3,0">
                                        <StackPanel>
                                            <TextBlock Text="AKTİF İHALE" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="İş" Style="{StaticResource FieldLabel}" Margin="0,7,0,0"/>
                                            <TextBlock x:Name="HomeWorkNameTextBlock" Text="—" Foreground="White" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"/>
                                            <TextBlock Text="Yüklenici" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="HomeContractorTextBlock" Text="—" Foreground="White" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Padding="15" Margin="3,5,2,0">
                                        <StackPanel>
                                            <TextBlock Text="HAKEDİŞ DURUMU" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="Son Hakediş" Style="{StaticResource FieldLabel}" Margin="0,7,0,0"/>
                                            <TextBlock x:Name="HomeProgressTextBlock" Text="—" Foreground="White" FontSize="24" FontWeight="Bold"/>
                                            <TextBlock Text="Dönem" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="HomePeriodTextBlock" Text="—" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock Text="Son Net Ödeme" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="HomeLatestNetTextBlock" Text="0,00 ₺" Foreground="White" FontSize="24" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource Card}" Padding="15" Margin="5,5,0,0">
                                        <StackPanel>
                                            <TextBlock Text="KAYIT / HAT DURUMU" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="Kayıtlı Net Toplam" Style="{StaticResource FieldLabel}" Margin="0,7,0,0"/>
                                            <TextBlock x:Name="HomeNetPayableTextBlock" Text="0,00 ₺" Foreground="White" FontSize="24" FontWeight="Bold"/>
                                            <TextBlock Text="Sözleşme / Hat Durumu" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="HomeContractStatusTextBlock" Text="Bekleniyor" Foreground="White" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                                            <TextBlock Text="Tanımlı Hat" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="HomeRouteCountTextBlock" Text="0" Foreground="White" FontSize="23" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        
                            </ScrollViewer>
</Grid>

                        <!-- İhale / Sözleşme -->
                        <Grid x:Name="ContractPanel" Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                            <StackPanel>
                                    <TextBlock Text="İHALE BİLGİLERİ" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Text="Sözleşme, yüklenici ve dönem bilgilerini tek ekrandan yönetin." Style="{StaticResource PageSubtitle}"/>

                                    <UniformGrid Columns="4" Margin="0,0,0,12">
                                        <Border Style="{StaticResource MetricCard}" Margin="0,0,8,0">
                                            <StackPanel><TextBlock Text="SÖZLEŞME DURUMU" Style="{StaticResource FieldLabel}"/>
                                                <TextBlock x:Name="ContractStatusSummaryTextBlock" Text="TASLAK" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Gold600Brush}"/>
                                                <TextBlock Text="Kayıt hazırlanmaya hazır" Style="{StaticResource CardSubtitle}"/></StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0">
                                            <StackPanel><TextBlock Text="SÖZLEŞME BEDELİ" Style="{StaticResource FieldLabel}"/>
                                                <TextBlock x:Name="ContractAmountSummaryTextBlock" Text="0,00 ₺" FontSize="21" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock Text="Girilen ana tutar" Style="{StaticResource CardSubtitle}"/></StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0">
                                            <StackPanel><TextBlock Text="BAŞLANGIÇ" Style="{StaticResource FieldLabel}"/>
                                                <TextBlock x:Name="ContractStartSummaryTextBlock" Text="—" FontSize="24" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock Text="İş başlangıç tarihi" Style="{StaticResource CardSubtitle}"/></StackPanel>

<Window x:Class="OzelEgitimHakedis.Wpf.MainWindow"
        xml:lang="tr-TR"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OzelEgitimHakedis.Wpf"
        Title="Taşımalı Eğitim Hakediş Yönetim Sistemi (TEHYS)"
        Width="1440"
        Height="900"
        MinWidth="1024"
        MinHeight="600"
        SizeToContent="Manual"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ShowInTaskbar="True"
        Background="{StaticResource Navy900Brush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        StateChanged="Window_StateChanged"
        SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <local:ContractWorkNameConverter x:Key="ContractWorkNameConverter"/>
    </Window.Resources>
    <Border x:Name="AppShellBorder"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            CornerRadius="15"
            BorderBrush="#35546F"
            BorderThickness="1"
            Background="{StaticResource Navy900Brush}"
            Margin="6.5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="NavigationColumn" Width="215"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ÜST BAR -->
                <Grid Grid.Row="0" Grid.ColumnSpan="2"
                      Background="{StaticResource Navy900Brush}"
                      MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="HeaderNavigationColumn" Width="215"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="15.5,0,0,0">
                        <TextBlock Text="TEHYS" Foreground="White" FontSize="18.5" FontWeight="Bold"/>
                        <TextBlock Text="TAŞIMALI EĞİTİM HAKEDİŞ" Foreground="#B9CBDA" FontSize="10.5" FontWeight="SemiBold" Margin="1,1,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            Width="170"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="#092746"
                            CornerRadius="9"
                            BorderBrush="#24496B"
                            BorderThickness="1"
                            Padding="8.5,6.5"
                            Margin="11.5,0,0,0">
                        <StackPanel>
                            <TextBlock Text="KAYIT DURUMU" Foreground="#8FA8C0" FontSize="10" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <Ellipse x:Name="HeaderSaveStatusDot" Width="9" Height="9" Fill="#FFB41F" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="HeaderSaveStatusTextBlock" Text="Başlatılıyor" Foreground="#FFE2A1" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Column="2" VerticalAlignment="Center" Margin="6.5,0,8.5,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#082744" BorderBrush="#24496B" BorderThickness="1" CornerRadius="9" Padding="8,6">
                            <StackPanel>
                                <TextBlock Text="AKTİF MODÜL" Foreground="#8FA8C0" FontSize="10" FontWeight="SemiBold"/>
                                <TextBlock x:Name="HeaderModuleText" Text="Ana Ekran" Foreground="White" FontSize="11.5" FontWeight="SemiBold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,6,0">
                                <TextBlock Text="HAZIRLIK" Foreground="#8FA8C0" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                <TextBlock Text="DURUMU" Foreground="#C3CFDC" FontSize="10.5" HorizontalAlignment="Right"/>
                            </StackPanel>
                            <Grid Width="48" Height="48">
                                <Ellipse Stroke="#29445F" StrokeThickness="5"/>
                                <Path x:Name="HeaderReadinessArc"
                                      Stroke="#FFB41F"
                                      StrokeThickness="5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M24,4 A20,20 0 1 1 4,24"/>
                                <TextBlock x:Name="HeaderReadinessText"
                                           Text="%0"
                                           Foreground="White"
                                           FontSize="11.5"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <Button Grid.Column="4" Content="—" ToolTip="Küçült" FontSize="13.5" FontWeight="SemiBold"
                                Foreground="White" Background="Transparent" BorderThickness="0" Width="44" Height="38"
                                Cursor="Hand" Click="Minimize_Click"/>
                        <Button x:Name="MaximizeRestoreButton" Grid.Column="5" ToolTip="Tam ekran"
                                Foreground="White" Background="Transparent" BorderThickness="0" Width="44" Height="38"
                                Cursor="Hand" Click="MaximizeRestore_Click">
                            <TextBlock x:Name="MaximizeRestoreIcon" FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE922;" FontSize="11.5" FontWeight="SemiBold"/>
                        </Button>
                        <Button Grid.Column="6" Content="×" ToolTip="Kapat" FontSize="16" Foreground="White"
                                Background="Transparent" BorderThickness="0" Width="44" Height="38"
                                Cursor="Hand" Click="Close_Click"/>
                    </Grid>
                </Grid>

                <!-- SOL MENÜ -->
                <Grid Grid.Row="1" Grid.Column="0" Background="{StaticResource Navy900Brush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="68"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                    <StackPanel Margin="0,6,0,0">
                        <Button x:Name="NavHome" Tag="Home" Uid="Active" Style="{StaticResource NavButton}" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" FontSize="15" Width="42"/>
                                <TextBlock Text="ANA EKRAN" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Border Height="3" Background="#557A9D" Margin="10,8" CornerRadius="1.5"/>
                        <Button x:Name="NavContract" Style="{StaticResource NavButton}" Tag="Contract" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8D2;" FontSize="15" Width="42"/>
                                <TextBlock Text="İHALE BİLGİLERİ" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
<Button x:Name="NavSignatories" Style="{StaticResource NavButton}" Tag="Signatories" Click="NavigationButton_Click"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" FontSize="15" Width="42"/><TextBlock Text="RESMÎ BELGE İMZACILARI" Width="120" TextWrapping="Wrap" FontSize="10.5" FontWeight="SemiBold"/></StackPanel></Button>
                        <Button x:Name="NavContractors" Style="{StaticResource NavButton}" Tag="Contractors" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70B;" FontSize="15" Width="42"/>
                                <TextBlock Text="YÜKLENİCİ FİRMALAR" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavLines" Style="{StaticResource NavButton}" Tag="Lines" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" FontSize="15" Width="42"/>
                                <TextBlock Text="HATLAR" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavProgress" Style="{StaticResource NavButton}" Tag="Progress" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D2;" FontSize="15" Width="42"/>
                                <TextBlock Text="HAKEDİŞ OLUŞTUR" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
<Button x:Name="NavReports" Style="{StaticResource NavButton}" Tag="Reports" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D2;" FontSize="15" Width="42"/>
                                <TextBlock Text="ÇIKTILAR" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Border Height="3" Background="#557A9D" Margin="10,8" CornerRadius="1.5"/>

                        <Button x:Name="NavHistory" Style="{StaticResource NavButton}" Tag="History" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE81C;" FontSize="15" Width="42"/>
                                <TextBlock Text="HAKEDİŞ GEÇMİŞİ" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavStatistics" Style="{StaticResource NavButton}" Tag="Statistics" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A1;" FontSize="15" Width="42"/>
                                <TextBlock Text="İSTATİSTİKLER" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavArchives" Style="{StaticResource NavButton}" Tag="Archives" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8F4;" FontSize="15" Width="42"/>
                                <TextBlock Text="ARŞİVLER" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="Settings" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="15" Width="42"/>
                                <TextBlock Text="AYARLAR" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavTemporaryCalculationTrace" Style="{StaticResource NavButton}" Tag="Trace" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8EF;" FontSize="15" Width="42"/>
                                <TextBlock Text="GEÇİCİ HESAP TUTUCU" FontSize="10.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="1" Margin="11.5,6,11.5,8" Padding="8.5,7" CornerRadius="9" Background="#082845" BorderBrush="#73581E" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Created by" Foreground="#A8BCD0" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="Aşkın KESKİNBALTA" Foreground="{StaticResource Gold500Brush}" FontSize="11.5" FontWeight="Bold" Margin="0,2,0,0"/>
                            <Border Height="2" Width="74" Background="{StaticResource Gold500Brush}" HorizontalAlignment="Left" Margin="0,6,0,0" CornerRadius="1"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- İÇERİK -->
                <Border Grid.Row="1" Grid.Column="1" Background="White" CornerRadius="13,0,13,0" Padding="11.5">
                    <Grid>
                        <Grid x:Name="HomePanel" Background="#061C32">

 <Grid.Resources>
  <!-- Project-owned vector symbols: stable on every Windows installation. -->
  <Geometry x:Key="HomeNetGeometry">M10,3 L22,3 20,8 12,8 Z M12,8 C9,12 5,18 5,23 C5,30 27,30 27,23 C27,18 23,12 20,8 M11,10 L22,10 M17,14 L15,25 M12,19 L21,17 M12,22 L20,20 M15,25 C20,27 22,23 22,22</Geometry>
  <Geometry x:Key="HomeGrossGeometry">M3,17 C3,13 17,13 17,17 C17,21 3,21 3,17 M3,17 L3,25 C3,29 17,29 17,25 L17,17 M3,22 C3,26 17,26 17,22 M18,5 C18,1 31,1 31,5 C31,9 18,9 18,5 M18,5 L18,20 C18,24 31,24 31,20 L31,5 M18,10 C18,14 31,14 31,10 M18,15 C18,19 31,19 31,15</Geometry>
  <Geometry x:Key="HomeDeductionsGeometry">M18,28 L4,28 4,3 19,3 25,9 25,15 M19,3 L19,9 25,9 M8,13 L19,13 M8,18 L14,18 M8,23 L13,23 M31,24 A8,8 0 1 1 15,24 A8,8 0 1 1 31,24 M19,24 L27,24</Geometry>
  <Geometry x:Key="HomeVatGeometry">M6,27 L27,4 M13,8 A5,5 0 1 1 3,8 A5,5 0 1 1 13,8 M30,24 A5,5 0 1 1 20,24 A5,5 0 1 1 30,24</Geometry>
  <Geometry x:Key="HomeTransportGeometry">M7,27 L7,30 10,30 10,27 M22,27 L22,30 25,30 25,27 M6,26 L26,26 26,7 Q26,3 22,3 L10,3 Q6,3 6,7 Z M7,10 L25,10 25,19 7,19 Z M12,6 L20,6 M10,23 L12,23 M20,23 L22,23 M3,11 L3,18 M29,11 L29,18</Geometry>
  <Geometry x:Key="HomeDifferenceGeometry">M25,28 L5,28 5,3 19,3 25,9 Z M19,3 L19,9 25,9 M9,12 L17,12 M9,17 L21,17 M9,22 L15,22 M22,21 L27,21 27,17 M27,21 L23,17 M14,25 L9,25 9,29 M9,25 L13,29</Geometry>
  <Geometry x:Key="HomeRoutesGeometry">M12,9 A5,5 0 1 0 2,9 C2,13 7,19 7,19 C7,19 12,13 12,9 M8,9 A1,1 0 1 1 6,9 A1,1 0 1 1 8,9 M30,17 A5,5 0 1 0 20,17 C20,21 25,27 25,27 C25,27 30,21 30,17 M26,17 A1,1 0 1 1 24,17 A1,1 0 1 1 26,17 M5,24 C5,29 10,29 12,27 M15,25 C18,23 19,27 21,29</Geometry>
  <Geometry x:Key="HomeFirmsGeometry">M4,29 L4,3 21,3 21,29 M21,14 L28,14 28,29 M1,29 L31,29 M8,7 L10,7 M15,7 L17,7 M8,12 L10,12 M15,12 L17,12 M8,17 L10,17 M15,17 L17,17 M10,29 L10,23 16,23 16,29 M24,19 L26,19 M24,24 L26,24</Geometry>
  <Style x:Key="HomeFinanceIcon" TargetType="ContentControl">
   <Setter Property="Width" Value="29"/><Setter Property="Height" Value="29"/>
   <Setter Property="Foreground" Value="#D4E4FC"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
    <Viewbox><Path Width="32" Height="32" Stretch="Uniform" Data="{TemplateBinding Content}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="HomeFinanceCard" TargetType="Border">
   <Setter Property="Background" Value="#0D2B49"/><Setter Property="BorderBrush" Value="#234361"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/>
   <Setter Property="Margin" Value="0,0,10,10"/><Setter Property="MinHeight" Value="124"/>
  </Style>
  <Style x:Key="HomeGoldButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
   <Setter Property="Background" Value="#F4C247"/><Setter Property="Foreground" Value="#08223A"/>
   <Setter Property="BorderBrush" Value="#FFDC7D"/><Setter Property="Padding" Value="20,10"/>
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Height" Value="Auto"/><Setter Property="MinHeight" Value="48"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="GoldActionBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Viewbox Width="25" Height="25" Margin="0,0,10,0"><Path Width="32" Height="32" Stretch="Uniform" Data="M20,29 L4,29 4,2 20,2 26,8 26,17 M20,2 L20,8 26,8 M8,13 L19,13 M8,18 L16,18 M32,24 A8,8 0 1 1 16,24 A8,8 0 1 1 32,24 M20,24 L28,24 M24,20 L24,28" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox><ContentPresenter VerticalAlignment="Center"/></StackPanel>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="GoldActionBorder" Property="Background" Value="#FFDA77"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="GoldActionBorder" Property="BorderBrush" Value="White"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="GoldActionBorder" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="GoldActionBorder" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="HomeComboItem" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
   <Setter Property="Background" Value="#0B2946"/><Setter Property="Foreground" Value="White"/>
   <Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#254D70"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#315777"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="HomeFilterCombo" TargetType="ComboBox" BasedOn="{StaticResource FieldComboBox}">
   <Setter Property="Height" Value="36"/><Setter Property="Background" Value="#0B2946"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#315371"/>
   <Setter Property="ItemContainerStyle" Value="{StaticResource HomeComboItem}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5"/>
    <ContentPresenter Margin="10,3,30,3" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
    <Path Data="M0,0 L5,5 10,0" Stroke="#C6D9F0" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
    <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template></ToggleButton>
    <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"><Border Background="#0B2946" BorderBrush="#315371" BorderThickness="1" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="280"><ScrollViewer CanContentScroll="True"><ItemsPresenter/></ScrollViewer></Border></Popup>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Grid.Resources>

 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14">
  <StackPanel>
   <TextBlock Text="ANA EKRAN" Foreground="White" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,14"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,12,0"><TextBlock Text="Program" Foreground="#DCE7F5" Margin="0,0,0,7"/><ComboBox x:Name="HomeProgramComboBox" Style="{StaticResource HomeFilterCombo}" SelectionChanged="HomeFilter_Changed"><ComboBoxItem Content="Özel Eğitim" Tag="SpecialEducation"/><ComboBoxItem Content="Temel / Ortaöğretim" Tag="BasicOrSecondary"/></ComboBox></StackPanel>
    <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="İKN" Foreground="#DCE7F5" Margin="0,0,0,7"/><ComboBox x:Name="HomeTenderListBox" Style="{StaticResource HomeFilterCombo}" SelectionChanged="HomeTenderListBox_SelectionChanged" ToolTip="Boş seçim tüm ihaleleri kapsar."><ComboBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding TenderNumber}"/><TextBlock FontSize="10" TextTrimming="CharacterEllipsis"><TextBlock.Text><MultiBinding Converter="{StaticResource ContractWorkNameConverter}" Mode="OneWay"><Binding/><Binding Path="Titles" Source="{StaticResource ContractWorkNameConverter}"/></MultiBinding></TextBlock.Text></TextBlock></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
    <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="Hakediş ayı" Foreground="#DCE7F5" Margin="0,0,0,7"/><DatePicker x:Name="HomeMonthPicker" Height="36" SelectedDateFormat="Short" SelectedDateChanged="HomeFilter_Changed" Background="#0B2946" Foreground="White" BorderBrush="#315371" ToolTip="Seçilen tarihin ayı kullanılır."><DatePicker.Resources><Style TargetType="DatePickerTextBox"><Setter Property="Background" Value="#0B2946"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style></DatePicker.Resources></DatePicker></StackPanel>
    <Button Grid.Column="3" Content="Tüm ihaleler" Click="HomeAllTenders_Click" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Height="36"/>
   </Grid>
   <TextBlock x:Name="HomeSelectedTenderSummaryTextBlock" Foreground="#AFC5DD" TextWrapping="Wrap" FontSize="11" Margin="0,7,0,14"/>
   <WrapPanel Margin="0,0,0,10"><TextBlock Text="Seçili dönemin özeti" Foreground="White" FontWeight="SemiBold" FontSize="17" Margin="0,0,14,0"/><TextBlock x:Name="HomeFinanceScopeText" Text="Program ve hakediş ayını seçin." Foreground="#AFC5DD" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/></WrapPanel>
   <UniformGrid x:Name="HomeFinanceCards" Columns="4" Rows="2" Margin="0,0,-10,6">
<Border x:Name="HomeNetCard" Background="#F4C247" BorderBrush="#FFD778" Style="{StaticResource HomeFinanceCard}" ToolTip="Kayıtlı hakedişlerin hesaplanan net ödeme toplamı."><Grid><StackPanel Margin="13,12,10,10">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ContentControl x:Name="HomeNetIcon" Style="{StaticResource HomeFinanceIcon}" Content="{StaticResource HomeNetGeometry}" Foreground="#08223A"/>
       <TextBlock Grid.Column="1" Text="Hesaplanan Net" Foreground="#08223A" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="6,0,0,0"/>
      </Grid>
      <Viewbox Height="39" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,8,0,0"><TextBlock x:Name="HomeNetValue" Text="0,00 ₺" Foreground="#08223A" FontFamily="Segoe UI" FontSize="30" FontWeight="Bold"/></Viewbox>
     </StackPanel></Grid></Border>
<Border Style="{StaticResource HomeFinanceCard}" ToolTip="KDV dahil brüt hakediş toplamı."><Grid><StackPanel Margin="13,12,10,10">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ContentControl x:Name="HomeGrossIcon" Style="{StaticResource HomeFinanceIcon}" Content="{StaticResource HomeGrossGeometry}" Foreground="#F4F7FF"/>
       <TextBlock Grid.Column="1" Text="Brüt Tutar" Foreground="#F4F7FF" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="6,0,0,0"/>
      </Grid>
      <Viewbox Height="39" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,8,0,0"><TextBlock x:Name="HomeGrossValue" Text="0,00 ₺" Foreground="#F4F7FF" FontFamily="Segoe UI" FontSize="30" FontWeight="Bold"/></Viewbox>
     </StackPanel></Grid></Border>
<Border Style="{StaticResource HomeFinanceCard}" ToolTip="Tevkifat ve diğer kesintilerin toplamı."><Grid><StackPanel Margin="13,12,10,10">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ContentControl x:Name="HomeDeductionsIcon" Style="{StaticResource HomeFinanceIcon}" Content="{StaticResource HomeDeductionsGeometry}" Foreground="#F4F7FF"/>
       <TextBlock Grid.Column="1" Text="Toplam Kesinti" Foreground="#F4F7FF" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="6,0,0,0"/>
      </Grid>

<Window x:Class="OzelEgitimHakedis.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Özel Eğitim Hakediş Sistemi (OEHS)"
        Width="1920"
        Height="1080"
        MinWidth="1280"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="8">
        <Border CornerRadius="15" BorderBrush="#35546F" BorderThickness="1" Background="{StaticResource Navy900Brush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="82"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="255"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ÜST BAR -->
                <Grid Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource Navy900Brush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="255"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="25,0,0,0">
                        <TextBlock Text="OEHS" Foreground="White" FontSize="29" FontWeight="Bold"/>
                        <TextBlock Text="ÖZEL EĞİTİM HAKEDİŞ" Foreground="#B9CBDA" FontSize="10.5" FontWeight="SemiBold" Margin="1,1,0,0"/>
                    </StackPanel>
                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="8,0,18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="108"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#082744" BorderBrush="#24496B" BorderThickness="1" CornerRadius="9" Padding="12,7">
                            <StackPanel>
                                <TextBlock Text="AKTİF MODÜL" Foreground="#8FA8C0" FontSize="10" FontWeight="SemiBold"/>
                                <TextBlock x:Name="HeaderModuleText" Text="Ana Ekran" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#092746" BorderBrush="#24496B" BorderThickness="1" CornerRadius="9" Padding="12,7">
                            <StackPanel>
                                <TextBlock Text="KAYIT DURUMU" Foreground="#8FA8C0" FontSize="10" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <Ellipse Width="9" Height="9" Fill="#43C77A" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="Hazır" Foreground="#DDF6E7" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Button Grid.Column="3" Content="KAYDET" Style="{StaticResource ModernButton}" Width="108" Height="40"/>
                    </Grid>
                </Grid>

                <!-- SOL MENÜ -->
                <Grid Grid.Row="1" Grid.Column="0" Background="{StaticResource Navy900Brush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="92"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,10,0,0">
                        <Button x:Name="NavHome" Tag="Active" Style="{StaticResource NavButton}" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" FontSize="21" Width="42"/>
                                <TextBlock Text="ANA EKRAN"/>
                            </StackPanel>
                        </Button>
                        <Border Height="3" Background="#557A9D" Margin="16,10" CornerRadius="1.5"/>
                        <Button x:Name="NavContract" Style="{StaticResource NavButton}" Tag="Contract" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8D2;" FontSize="21" Width="42"/>
                                <TextBlock Text="İHALE / SÖZLEŞME"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavLines" Style="{StaticResource NavButton}" Tag="Lines" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" FontSize="21" Width="42"/>
                                <TextBlock Text="HATLAR"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavContractors" Style="{StaticResource NavButton}" Tag="Contractors" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;" FontSize="21" Width="42"/>
                                <TextBlock Text="YÜKLENİCİLER"/>
                            </StackPanel>
                        </Button>
                        <Border Height="3" Background="#557A9D" Margin="16,10" CornerRadius="1.5"/>
                        <Button x:Name="NavProgress" Style="{StaticResource NavButton}" Tag="Progress" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D2;" FontSize="21" Width="42"/>
                                <TextBlock Text="HAKEDİŞ OLUŞTUR"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavHistory" Style="{StaticResource NavButton}" Tag="History" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE81C;" FontSize="21" Width="42"/>
                                <TextBlock Text="HAKEDİŞ GEÇMİŞİ"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavSummary" Style="{StaticResource NavButton}" Tag="Summary" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D5;" FontSize="21" Width="42"/>
                                <TextBlock Text="İCMAL"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavReports" Style="{StaticResource NavButton}" Tag="Reports" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D2;" FontSize="21" Width="42"/>
                                <TextBlock Text="RAPORLAR"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="Settings" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="21" Width="42"/>
                                <TextBlock Text="AYARLAR"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Border Grid.Row="1" Margin="18,7,18,10" Padding="14,9" CornerRadius="9" Background="#082845" BorderBrush="#73581E" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Created by" Foreground="#A8BCD0" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="OEHS" Foreground="{StaticResource Gold500Brush}" FontSize="19" FontWeight="Bold" Margin="0,2,0,0"/>
                            <Border Height="2" Width="74" Background="{StaticResource Gold500Brush}" HorizontalAlignment="Left" Margin="0,6,0,0" CornerRadius="1"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- İÇERİK -->
                <Border Grid.Row="1" Grid.Column="1" Background="White" CornerRadius="13,0,13,0" Padding="24">
                    <Grid>
                        <Grid x:Name="HomePanel">
                            <StackPanel>
                                <TextBlock Text="ÖZEL EĞİTİM HAKEDİŞ SİSTEMİ" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Hakediş sürecini sözleşmeden hesaplamaya kadar tek akışta yönetin." Style="{StaticResource PageSubtitle}"/>
                                <Border Style="{StaticResource PremiumPanel}" Padding="20" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="245"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="#1D4B70" CornerRadius="11" Padding="9,4" Margin="0,0,10,0">
                                                    <TextBlock Text="AKTİF İŞLEM" Foreground="#D9E9F6" FontSize="11" FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock Text="HAZIR" Foreground="{StaticResource Gold500Brush}" FontSize="11.5" FontWeight="Bold"/>
                                            </StackPanel>
                                            <TextBlock Text="Önce sözleşmeyi tanımlayın" Foreground="White" FontSize="23" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                            <TextBlock Text="Sözleşme → Hatlar → Hakediş akışı burada ilerleyecek." Foreground="#C5D7E7" FontSize="13" Margin="0,5,0,0"/>
                                            <Button Content="İHALE / SÖZLEŞME TANIMLA" Tag="Contract" Click="NavigationButton_Click"
                                                    Style="{StaticResource ModernButton}" Width="230" Height="42"
                                                    HorizontalAlignment="Left" Margin="0,18,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#0A2A49" BorderBrush="#335A79" BorderThickness="1" CornerRadius="11" Padding="15,12" VerticalAlignment="Center">
                                            <StackPanel>
                                                <TextBlock Text="SİSTEM" Foreground="#91ABC0" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                <TextBlock Text="OEHS v0.5" Foreground="White" FontSize="21" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                                <Border Height="1" Background="#315371" Margin="0,11,0,9"/>
                                                <TextBlock Text="HESAPLAMA MOTORU" Foreground="#91ABC0" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                <TextBlock Text="HAZIR" Foreground="{StaticResource Gold500Brush}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource CardCompact}" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="01  SÖZLEŞME" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Text="İhale ve sözleşme temel bilgilerini girin." Foreground="{StaticResource Text600Brush}" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource CardCompact}" Margin="4,0">
                                        <StackPanel>
                                            <TextBlock Text="02  HATLAR" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Text="Sözleşmeye bağlı hizmet hatlarını tanımlayın." Foreground="{StaticResource Text600Brush}" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource CardCompact}" Margin="8,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="03  HAKEDİŞ" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Text="Hesaplama motoruyla dönem tutarını oluşturun." Foreground="{StaticResource Text600Brush}" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- İhale / Sözleşme -->
                        <Grid x:Name="ContractPanel" Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="İHALE / SÖZLEŞME" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Text="Sözleşme, yüklenici ve dönem bilgilerini tek ekrandan yönetin." Style="{StaticResource PageSubtitle}"/>

                                    <UniformGrid Columns="4" Margin="0,0,0,16">
                                        <Border Style="{StaticResource MetricCard}" Margin="0,0,8,0">
                                            <StackPanel><TextBlock Text="SÖZLEŞME DURUMU" Style="{StaticResource FieldLabel}"/>
                                                <TextBlock Text="TASLAK" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Gold600Brush}"/>
                                                <TextBlock Text="Kayıt hazırlanmaya hazır" Style="{StaticResource CardSubtitle}"/></StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0">
                                            <StackPanel><TextBlock Text="SÖZLEŞME BEDELİ" Style="{StaticResource FieldLabel}"/>
                                                <TextBlock Text="0,00 ₺" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Text900Brush}"/>
                                                <TextBlock Text="Girilen ana tutar" Style="{StaticResource CardSubtitle}"/></StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0">
                                            <StackPanel><TextBlock Text="BAŞLANGIÇ" Style="{StaticResource FieldLabel}"/>
                                                <TextBlock Text="—" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Text900Brush}"/>
                                                <TextBlock Text="İş başlangıç tarihi" Style="{StaticResource CardSubtitle}"/></StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource MetricCard}" Margin="8,0,0,0">
                                            <StackPanel><TextBlock Text="BİTİŞ" Style="{StaticResource FieldLabel}"/>
                                                <TextBlock Text="—" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Text900Brush}"/>
                                                <TextBlock Text="İş bitiş tarihi" Style="{StaticResource CardSubtitle}"/></StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                                            <StackPanel>
                                                <TextBlock Text="Sözleşme Bilgileri" Style="{StaticResource CardTitle}"/>
                                                <TextBlock Text="Temel ihale ve sözleşme alanları" Style="{StaticResource CardSubtitle}" Margin="0,0,0,18"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="170"/><ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="170"/><ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="İhale / Dosya No" Style="{StaticResource FieldLabel}" Margin="0,8"/>
                                                    <TextBox x:Name="TenderNumberTextBox" Grid.Row="0" Grid.Column="1" Margin="8" Style="{StaticResource FieldTextBox}"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Sözleşme No" Style="{StaticResource FieldLabel}" Margin="18,8,0,8"/>
                                                    <TextBox x:Name="ContractNumberTextBox" Grid.Row="0" Grid.Column="3" Margin="8" Style="{StaticResource FieldTextBox}"/>

                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="İşin Adı" Style="{StaticResource FieldLabel}" Margin="0,8"/>
                                                    <TextBox x:Name="WorkNameTextBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="8" Style="{StaticResource FieldTextBox}"/>

                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Yüklenici" Style="{StaticResource FieldLabel}" Margin="0,8"/>
                                                    <TextBox x:Name="ContractorTextBox" Grid.Row="2" Grid.Column="1" Margin="8" Style="{StaticResource FieldTextBox}"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Sözleşme Bedeli" Style="{StaticResource FieldLabel}" Margin="18,8,0,8"/>
                                                    <TextBox x:Name="ContractAmountTextBox" Grid.Row="2" Grid.Column="3" Margin="8" Style="{StaticResource FieldTextBox}"/>

                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Başlangıç Tarihi" Style="{StaticResource FieldLabel}" Margin="0,8"/>
                                                    <DatePicker x:Name="StartDatePicker" Grid.Row="3" Grid.Column="1" Margin="8" Style="{StaticResource FieldDatePicker}"/>
                                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Bitiş Tarihi" Style="{StaticResource FieldLabel}" Margin="18,8,0,8"/>
                                                    <DatePicker x:Name="EndDatePicker" Grid.Row="3" Grid.Column="3" Margin="8" Style="{StaticResource FieldDatePicker}"/>
                                                </Grid>
                                                <Border Style="{StaticResource StatusBanner}" Margin="8,14,8,0">
                                                    <Grid><TextBlock Text="Vergi durumu" FontWeight="SemiBold" Foreground="{StaticResource Text900Brush}"/>
                                                        <CheckBox x:Name="VatExemptCheckBox" Content="KDV istisnası uygulanacak" HorizontalAlignment="Right" FontFamily="Segoe UI" FontSize="14"/></Grid>
                                                </Border>
                                                <StackPanel Orientation="Horizontal" Margin="8,20,8,0">
                                                    <Button Content="KAYDET" Click="SaveContractButton_Click" Style="{StaticResource ModernButton}" Width="140"/>
                                                    <Button Content="TEMİZLE" Click="ClearContractButton_Click" Style="{StaticResource SecondaryButton}" Width="120" Margin="10,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock x:Name="ContractStatusTextBlock" Margin="8,14,8,0" Foreground="{StaticResource Blue600Brush}"/>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <Border Style="{StaticResource PremiumPanel}" Padding="22">
                                                <StackPanel>
                                                    <TextBlock Text="SÖZLEŞME ÖZETİ" Foreground="{StaticResource Gold500Brush}" FontSize="13" FontWeight="Bold"/>
                                                    <TextBlock Text="Hakediş akışının başlangıç noktası" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                                    <TextBlock Text="Bu kayıt tamamlandığında hatlar ve dönemsel hakediş işlemleri bu sözleşme üzerinden ilerleyecek." Foreground="#C5D7E7" TextWrapping="Wrap" FontSize="14"/>
                                                    <Border Height="1" Background="#315371" Margin="0,18,0,14"/>
                                                    <Grid>
                                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                        <TextBlock Grid.Row="0" Text="İhale bilgisi" Foreground="#91ABC0"/>
                                                        <TextBlock Grid.Row="0" Text="Bekleniyor" Foreground="White" HorizontalAlignment="Right"/>
                                                        <TextBlock Grid.Row="1" Text="Yüklenici" Foreground="#91ABC0" Margin="0,12,0,0"/>
                                                        <TextBlock Grid.Row="1" Text="Bekleniyor" Foreground="White" HorizontalAlignment="Right" Margin="0,12,0,0"/>
                                                        <TextBlock Grid.Row="2" Text="KDV durumu" Foreground="#91ABC0" Margin="0,12,0,0"/>
                                                        <TextBlock Grid.Row="2" Text="Standart" Foreground="{StaticResource Gold500Brush}" HorizontalAlignment="Right" Margin="0,12,0,0"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="SONRAKİ ADIMLAR" Style="{StaticResource CardTitle}"/>
                                                    <TextBlock Text="01  Hatları tanımla" Style="{StaticResource CardSubtitle}" Margin="0,10,0,0"/>
                                                    <TextBlock Text="02  Dönem bilgilerini gir" Style="{StaticResource CardSubtitle}" Margin="0,7,0,0"/>
                                                    <TextBlock Text="03  Hakedişi oluştur" Style="{StaticResource CardSubtitle}" Margin="0,7,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- Hakediş -->
                        <Grid x:Name="ProgressPanel" Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="HAKEDİŞ OLUŞTUR" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Text="Dönem hesabını girin, sonucu kontrol edin ve ödeme tutarını oluşturun." Style="{StaticResource PageSubtitle}"/>

                                    <UniformGrid Columns="4" Margin="0,0,0,16">
                                        <Border Style="{StaticResource MetricCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="DÖNEM" Style="{StaticResource FieldLabel}"/><TextBlock Text="YENİ HAKEDİŞ" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Blue600Brush}"/><TextBlock Text="Hesaplama hazırlığı" Style="{StaticResource CardSubtitle}"/></StackPanel></Border>
                                        <Border Style="{StaticResource MetricCard}" Margin="4,0"><StackPanel><TextBlock Text="İŞ GÜNÜ" Style="{StaticResource FieldLabel}"/><TextBlock Text="0" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Text900Brush}"/><TextBlock Text="Çalışılan gün" Style="{StaticResource CardSubtitle}"/></StackPanel></Border>
                                        <Border Style="{StaticResource MetricCard}" Margin="4,0"><StackPanel><TextBlock Text="HESAP DURUMU" Style="{StaticResource FieldLabel}"/><TextBlock Text="HAZIR" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Gold600Brush}"/><TextBlock Text="Sonuç bekleniyor" Style="{StaticResource CardSubtitle}"/></StackPanel></Border>
                                        <Border Style="{StaticResource MetricCard}" Margin="8,0,0,0"><StackPanel><TextBlock Text="NET ÖDEME" Style="{StaticResource FieldLabel}"/><TextBlock Text="0,00 ₺" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Blue600Brush}"/><TextBlock Text="Hesap sonrası" Style="{StaticResource CardSubtitle}"/></StackPanel></Border>
                                    </UniformGrid>

                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource PremiumPanel}" Padding="24" Margin="0,0,10,0">
                                            <StackPanel>
                                                <TextBlock Text="DÖNEM HESAP BİLGİLERİ" Foreground="{StaticResource Gold500Brush}" FontSize="13" FontWeight="Bold"/>
                                                <TextBlock Text="Hakediş hesaplama girdileri" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,18"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="İş Günü" Foreground="#D8E4EF" Style="{StaticResource FieldLabel}" Margin="0,8"/>
                                                    <TextBox x:Name="WorkDaysTextBox" Grid.Row="0" Grid.Column="1" Margin="8" Style="{StaticResource PremiumFieldTextBox}"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Günlük Fiyat" Foreground="#D8E4EF" Style="{StaticResource FieldLabel}" Margin="16,8,0,8"/>
                                                    <TextBox x:Name="DailyPriceTextBox" Grid.Row="0" Grid.Column="3" Margin="8" Style="{StaticResource PremiumFieldTextBox}"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="İskonto" Foreground="#D8E4EF" Style="{StaticResource FieldLabel}" Margin="0,8"/>
                                                    <TextBox x:Name="DiscountTextBox" Grid.Row="1" Grid.Column="1" Margin="8" Style="{StaticResource PremiumFieldTextBox}"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Fiyat Farkı" Foreground="#D8E4EF" Style="{StaticResource FieldLabel}" Margin="16,8,0,8"/>
                                                    <TextBox x:Name="PriceDifferenceTextBox" Grid.Row="1" Grid.Column="3" Margin="8" Style="{StaticResource PremiumFieldTextBox}"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Sözleşme Bedeli" Foreground="#D8E4EF" Style="{StaticResource FieldLabel}" Margin="0,8"/>
                                                    <TextBox x:Name="ProgressContractAmountTextBox" Grid.Row="2" Grid.Column="1" Margin="8" Style="{StaticResource PremiumFieldTextBox}"/>
                                                    <CheckBox x:Name="ProgressVatExemptCheckBox" Grid.Row="2" Grid.Column="2" Content="KDV istisnası" Foreground="White" FontFamily="Segoe UI" FontSize="14" VerticalAlignment="Center" Margin="16,8,0,8"/>
                                                    <CheckBox x:Name="InspectionPenaltyCheckBox" Grid.Row="2" Grid.Column="3" Content="Denetim cezası uygula" Foreground="White" FontFamily="Segoe UI" FontSize="14" VerticalAlignment="Center" Margin="8"/>
                                                </Grid>
                                                <Button Content="HAKEDİŞİ HESAPLA" Click="CalculateProgressButton_Click" Style="{StaticResource ModernButton}" Width="205" Margin="8,20,0,0" HorizontalAlignment="Left"/>
                                                <TextBlock x:Name="CalculationStatusTextBlock" Margin="8,14,8,0" Foreground="{StaticResource Gold500Brush}"/>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <Border Style="{StaticResource PremiumPanel}" Padding="22">
                                                <StackPanel>
                                                    <TextBlock Text="SONUÇ ÖZETİ" Foreground="{StaticResource Gold500Brush}" FontSize="13" FontWeight="Bold"/>
                                                    <TextBlock Text="Net ödenecek tutar" Foreground="#C5D7E7" FontSize="14" Margin="0,7,0,0"/>
                                                    <TextBlock x:Name="NetResultTextBlock" Text="0,00 ₺" Foreground="White" FontSize="34" FontWeight="Bold" Margin="0,2,0,0"/>
                                                    <Border Height="1" Background="#315371" Margin="0,16,0,12"/>
                                                    <Grid>
                                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                        <TextBlock Grid.Row="0" Text="Hizmet Tutarı" Foreground="#91ABC0"/>

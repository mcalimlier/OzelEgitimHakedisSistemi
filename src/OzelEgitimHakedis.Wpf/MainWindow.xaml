<Window x:Class="OzelEgitimHakedis.Wpf.MainWindow"
        xml:lang="tr-TR"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Taşımalı Eğitim Hakediş Yönetim Sistemi (TEHYS)"
        Width="1440"
        Height="900"
        MinWidth="1024"
        MinHeight="600"
        SizeToContent="Manual"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ShowInTaskbar="True"
        Background="{StaticResource Navy900Brush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        StateChanged="Window_StateChanged">
    <Border x:Name="AppShellBorder"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            CornerRadius="15"
            BorderBrush="#35546F"
            BorderThickness="1"
            Background="{StaticResource Navy900Brush}"
            Margin="6.5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="215"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ÜST BAR -->
                <Grid Grid.Row="0" Grid.ColumnSpan="2"
                      Background="{StaticResource Navy900Brush}"
                      MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="215"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="15.5,0,0,0">
                        <TextBlock Text="TEHYS" Foreground="White" FontSize="18.5" FontWeight="Bold"/>
                        <TextBlock Text="TAŞIMALI EĞİTİM HAKEDİŞ" Foreground="#B9CBDA" FontSize="10.5" FontWeight="SemiBold" Margin="1,1,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            Width="170"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="#092746"
                            CornerRadius="9"
                            BorderBrush="#24496B"
                            BorderThickness="1"
                            Padding="8.5,6.5"
                            Margin="11.5,0,0,0">
                        <StackPanel>
                            <TextBlock Text="KAYIT DURUMU" Foreground="#8FA8C0" FontSize="10" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <Ellipse x:Name="HeaderSaveStatusDot" Width="9" Height="9" Fill="#FFB41F" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="HeaderSaveStatusTextBlock" Text="Başlatılıyor" Foreground="#FFE2A1" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Column="2" VerticalAlignment="Center" Margin="6.5,0,8.5,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#082744" BorderBrush="#24496B" BorderThickness="1" CornerRadius="9" Padding="8,6">
                            <StackPanel>
                                <TextBlock Text="AKTİF MODÜL" Foreground="#8FA8C0" FontSize="10" FontWeight="SemiBold"/>
                                <TextBlock x:Name="HeaderModuleText" Text="Ana Ekran" Foreground="White" FontSize="11.5" FontWeight="SemiBold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,6,0">
                                <TextBlock Text="HAZIRLIK" Foreground="#8FA8C0" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                <TextBlock Text="DURUMU" Foreground="#C3CFDC" FontSize="10.5" HorizontalAlignment="Right"/>
                            </StackPanel>
                            <Grid Width="48" Height="48">
                                <Ellipse Stroke="#29445F" StrokeThickness="5"/>
                                <Path x:Name="HeaderReadinessArc"
                                      Stroke="#FFB41F"
                                      StrokeThickness="5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M24,4 A20,20 0 1 1 4,24"/>
                                <TextBlock x:Name="HeaderReadinessText"
                                           Text="%0"
                                           Foreground="White"
                                           FontSize="11.5"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <Button Grid.Column="4" Content="—" ToolTip="Küçült" FontSize="13.5" FontWeight="SemiBold"
                                Foreground="White" Background="Transparent" BorderThickness="0" Width="44" Height="38"
                                Cursor="Hand" Click="Minimize_Click"/>
                        <Button x:Name="MaximizeRestoreButton" Grid.Column="5" ToolTip="Tam ekran"
                                Foreground="White" Background="Transparent" BorderThickness="0" Width="44" Height="38"
                                Cursor="Hand" Click="MaximizeRestore_Click">
                            <TextBlock x:Name="MaximizeRestoreIcon" FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE922;" FontSize="11.5" FontWeight="SemiBold"/>
                        </Button>
                        <Button Grid.Column="6" Content="×" ToolTip="Kapat" FontSize="16" Foreground="White"
                                Background="Transparent" BorderThickness="0" Width="44" Height="38"
                                Cursor="Hand" Click="Close_Click"/>
                    </Grid>
                </Grid>

                <!-- SOL MENÜ -->
                <Grid Grid.Row="1" Grid.Column="0" Background="{StaticResource Navy900Brush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="68"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,6,0,0">
                        <Button x:Name="NavHome" Tag="Home" Uid="Active" Style="{StaticResource NavButton}" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" FontSize="15" Width="42"/>
                                <TextBlock Text="ANA EKRAN" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Border Height="3" Background="#557A9D" Margin="10,8" CornerRadius="1.5"/>
                        <Button x:Name="NavContract" Style="{StaticResource NavButton}" Tag="Contract" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8D2;" FontSize="15" Width="42"/>
                                <TextBlock Text="İHALE BİLGİLERİ" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavContractors" Style="{StaticResource NavButton}" Tag="Contractors" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70B;" FontSize="15" Width="42"/>
                                <TextBlock Text="YÜKLENİCİ FİRMALAR" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavLines" Style="{StaticResource NavButton}" Tag="Lines" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" FontSize="15" Width="42"/>
                                <TextBlock Text="HATLAR" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavProgress" Style="{StaticResource NavButton}" Tag="Progress" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D2;" FontSize="15" Width="42"/>
                                <TextBlock Text="HAKEDİŞ OLUŞTUR" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Border Height="3" Background="#557A9D" Margin="10,8" CornerRadius="1.5"/>
                        <Button x:Name="NavReports" Style="{StaticResource NavButton}" Tag="Reports" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D2;" FontSize="15" Width="42"/>
                                <TextBlock Text="ÇIKTILAR" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavHistory" Style="{StaticResource NavButton}" Tag="History" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE81C;" FontSize="15" Width="42"/>
                                <TextBlock Text="HAKEDİŞ GEÇMİŞİ" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavAcceptance" Style="{StaticResource NavButton}" Tag="Statistics" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A1;" FontSize="15" Width="42"/>
                                <TextBlock Text="İSTATİSTİKLER" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavArchives" Style="{StaticResource NavButton}" Tag="Archives" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8F4;" FontSize="15" Width="42"/>
                                <TextBlock Text="ARŞİVLER" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="Settings" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="15" Width="42"/>
                                <TextBlock Text="AYARLAR" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavTemporaryCalculationTrace" Style="{StaticResource NavButton}" Tag="Trace" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8EF;" FontSize="15" Width="42"/>
                                <TextBlock Text="GEÇİCİ HESAP TUTUCU" FontSize="10.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Border Grid.Row="1" Margin="11.5,6,11.5,8" Padding="8.5,7" CornerRadius="9" Background="#082845" BorderBrush="#73581E" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Created by" Foreground="#A8BCD0" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="Aşkın KESKİNBALTA" Foreground="{StaticResource Gold500Brush}" FontSize="11.5" FontWeight="Bold" Margin="0,2,0,0"/>
                            <Border Height="2" Width="74" Background="{StaticResource Gold500Brush}" HorizontalAlignment="Left" Margin="0,6,0,0" CornerRadius="1"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- İÇERİK -->
                <Border Grid.Row="1" Grid.Column="1" Background="White" CornerRadius="13,0,13,0" Padding="11.5">
                    <Grid>
                        <Grid x:Name="HomePanel">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                            <StackPanel>
                                <TextBlock Text="TAŞIMALI EĞİTİM HAKEDİŞ YÖNETİM SİSTEMİ" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Hakediş sürecini sözleşmeden hesaplamaya kadar tek akışta yönetin." Style="{StaticResource PageSubtitle}"/>
                                <Border Style="{StaticResource PremiumPanel}" Padding="12.5" Margin="0,0,0,8.5">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="#1D4B70" CornerRadius="11" Padding="7,4" Margin="0,0,8,0">
                                                    <TextBlock Text="AKTİF İŞLEM" Foreground="#D9E9F6" FontSize="11" FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock Text="HAZIR" Foreground="{StaticResource Gold500Brush}" FontSize="11.5" FontWeight="Bold"/>
                                            </StackPanel>
                                            <TextBlock Text="Önce sözleşmeyi tanımlayın" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                            <TextBlock Text="İhale → Yüklenici → Hat → Hakediş → Çıktı akışı burada ilerleyecek." Foreground="#C5D7E7" FontSize="11.5" Margin="0,5,0,0"/>
                                            <Button Content="İHALE BİLGİLERİ TANIMLA" Tag="Contract" Click="NavigationButton_Click"
                                                    Style="{StaticResource ModernButton}" Width="245" Height="31"
                                                    HorizontalAlignment="Left" Margin="0,11.5,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#0A2A49" BorderBrush="#335A79" BorderThickness="1" CornerRadius="11" Padding="9,8" VerticalAlignment="Center">
                                            <StackPanel>
                                                <TextBlock Text="SİSTEM" Foreground="#91ABC0" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                <TextBlock Text="OEHS v0.5" Foreground="White" FontSize="13.5" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                                <Border Height="1" Background="#315371" Margin="0,7.5,0,7"/>
                                                <TextBlock Text="HESAPLAMA MOTORU" Foreground="#91ABC0" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                <TextBlock Text="HAZIR" Foreground="{StaticResource Gold500Brush}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                                                                                                <Border Style="{StaticResource Card}" Padding="8.5" Margin="0,0,0,8.5">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.8*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="AKTİF İHALE / DOSYA NO" Style="{StaticResource CardTitle}"/>
                                            <ComboBox x:Name="HomeTenderListBox"
                                                      Height="34"
                                                      Margin="0,6,8,0"
                                                      SelectionChanged="HomeTenderListBox_SelectionChanged"
                                                      Style="{StaticResource FieldComboBox}"
                                                      ToolTip="İhale / dosya numarasını seçin">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding TenderNumber}" FontSize="11.5" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding TenderNumber, StringFormat='İKN: {0}'}" FontSize="10" Foreground="{StaticResource Text600Brush}"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding WorkName}" FontSize="10.5" Foreground="{StaticResource Text600Brush}" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#0A2A49" BorderBrush="#335A79" BorderThickness="1" CornerRadius="9" Padding="8.5">
                                            <StackPanel>
                                                <TextBlock Text="SEÇİLEN İHALE ÖZETİ" Foreground="{StaticResource Gold500Brush}" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock x:Name="HomeSelectedTenderSummaryTextBlock" Text="İhale seçiniz." Foreground="White" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>                                                                <Border Style="{StaticResource Card}" Padding="8.5" Margin="0,0,0,8.5">
                                    <StackPanel>
                                        <TextBlock Text="İŞ AKIŞI / İLERLEME ŞABLONU" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="Önce ana bilgileri girin; dönem hesabını kontrol edip arşivleyin, ardından dört belgeyi üretin. Ana kayıt formları kaydetme sonrası temizlenir." Style="{StaticResource CardSubtitle}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        <UniformGrid Columns="6" Margin="0,8,0,0">
                                            <Border Background="#0A2A49" BorderBrush="#335A79" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,4,0">
                                                <StackPanel>
                                                    <TextBlock Text="01 →" Foreground="{StaticResource Gold500Brush}" FontSize="10.5" FontWeight="Bold"/>
                                                    <Button Content="SÖZLEŞME" Tag="Contract" Click="NavigationButton_Click" Style="{StaticResource SecondaryButton}" Height="30" FontSize="10.5" Margin="0,4,0,3"/>
                                                    <TextBlock Text="İhale no, bedel, tarihler" Foreground="#C5D7E7" FontSize="10" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#0A2A49" BorderBrush="#335A79" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,4,0">
                                                <StackPanel>
                                                    <TextBlock Text="02 →" Foreground="{StaticResource Gold500Brush}" FontSize="10.5" FontWeight="Bold"/>
                                                    <Button Content="YÜKLENİCİ" Tag="Contractors" Click="NavigationButton_Click" Style="{StaticResource SecondaryButton}" Height="30" FontSize="10.5" Margin="0,4,0,3"/>
                                                    <TextBlock Text="Kimlik, iletişim, banka" Foreground="#C5D7E7" FontSize="10" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#0A2A49" BorderBrush="#335A79" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,4,0">
                                                <StackPanel>
                                                    <TextBlock Text="03 →" Foreground="{StaticResource Gold500Brush}" FontSize="10.5" FontWeight="Bold"/>
                                                    <Button Content="HAT" Tag="Lines" Click="NavigationButton_Click" Style="{StaticResource SecondaryButton}" Height="30" FontSize="10.5" Margin="0,4,0,3"/>
                                                    <TextBlock Text="İş günleri, rehber fiyatı" Foreground="#C5D7E7" FontSize="10" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#0A2A49" BorderBrush="#335A79" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,4,0">
                                                <StackPanel>
                                                    <TextBlock Text="04 →" Foreground="{StaticResource Gold500Brush}" FontSize="10.5" FontWeight="Bold"/>
                                                    <Button Content="HAKEDİŞ" Tag="Progress" Click="NavigationButton_Click" Style="{StaticResource SecondaryButton}" Height="30" FontSize="10.5" Margin="0,4,0,3"/>
                                                    <TextBlock Text="Dönem, farklar, kesintiler" Foreground="#C5D7E7" FontSize="10" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#0A2A49" BorderBrush="#335A79" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,4,0">
                                                <StackPanel>
                                                    <TextBlock Text="05 →" Foreground="{StaticResource Gold500Brush}" FontSize="10.5" FontWeight="Bold"/>
                                                    <Button Content="ARŞİV" Tag="Archives" Click="NavigationButton_Click" Style="{StaticResource SecondaryButton}" Height="30" FontSize="10.5" Margin="0,4,0,3"/>
                                                    <TextBlock Text="Kontrol et, kaydı sakla" Foreground="#C5D7E7" FontSize="10" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#0A2A49" BorderBrush="#335A79" BorderThickness="1" CornerRadius="8" Padding="6">
                                                <StackPanel>
                                                    <TextBlock Text="06 ✓" Foreground="{StaticResource Gold500Brush}" FontSize="10.5" FontWeight="Bold"/>
                                                    <Button Content="ÇIKTILAR" Tag="Reports" Click="NavigationButton_Click" Style="{StaticResource SecondaryButton}" Height="30" FontSize="10.5" Margin="0,4,0,3"/>
                                                    <TextBlock Text="Önizle, dört PDF kaydet" Foreground="#C5D7E7" FontSize="10" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
<Grid Margin="0,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Padding="9" Margin="0,0,5,5">
                                        <StackPanel>
                                            <TextBlock Text="TAŞIMA HİZMETİ" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="Taşıma Hizmet" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="HomeTransportServiceTextBlock" Text="0,00 ₺" Foreground="White" FontSize="15" FontWeight="Bold"/>
                                            <TextBlock Text="Taşıma Fiyat Farkı" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="HomeTransportPriceDifferenceTextBlock" Text="0,00 ₺" Foreground="White" FontSize="12.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="Taşıma Hakediş" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="HomeTransportNetTextBlock" Text="0,00 ₺" Foreground="White" FontSize="15" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Padding="9" Margin="2,0,3,5">
                                        <StackPanel>
                                            <TextBlock Text="REHBER HİZMETİ" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="Rehber Hizmet" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="HomeGuideServiceTextBlock" Text="0,00 ₺" Foreground="White" FontSize="15" FontWeight="Bold"/>
                                            <TextBlock Text="Rehber Hakediş" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="HomeGuideNetTextBlock" Text="0,00 ₺" Foreground="White" FontSize="15" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}" Padding="9" Margin="3,0,2,5">
                                        <StackPanel>
                                            <TextBlock Text="VERGİ &amp; TEVKİFAT" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="KDV" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="HomeVatTextBlock" Text="0,00 ₺" Foreground="White" FontSize="15" FontWeight="Bold"/>
                                            <TextBlock Text="KDV / Tevkifat" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="HomeVatWithholdingTextBlock" Text="0,00 / 0,00 ₺" Foreground="White" FontSize="12.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="Tevkifat" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="HomeWithholdingTextBlock" Text="0,00 ₺" Foreground="White" FontSize="15" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource Card}" Padding="9" Margin="5,0,0,5">
                                        <StackPanel>
                                            <TextBlock Text="DİĞER KESİNTİLER" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="Damga Vergisi" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="HomeStampTaxTextBlock" Text="0,00 ₺" Foreground="White" FontSize="13.5" FontWeight="Bold"/>
                                            <TextBlock Text="Fiyat Farkı Teminatı" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="HomeGuaranteeTextBlock" Text="0,00 ₺" Foreground="White" FontSize="13.5" FontWeight="Bold"/>
                                            <TextBlock Text="Toplam Kesinti" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="HomeDeductionsTextBlock" Text="0,00 ₺" Foreground="White" FontSize="15" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Padding="9" Margin="0,5,5,0">
                                        <StackPanel>
                                            <TextBlock Text="TAHAKKUK" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="Toplam Tutar" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="HomeTotalAmountTextBlock" Text="0,00 ₺" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                            <TextBlock Text="Fatura Tutarı" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="HomeInvoiceTextBlock" Text="0,00 ₺" Foreground="White" FontSize="14.5" FontWeight="Bold"/>

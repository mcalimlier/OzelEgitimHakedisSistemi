<Border Grid.Column="1" Style="{StaticResource CardCompact}" Margin="4,0"><StackPanel><TextBlock Text="İCMAL RAPORU" Style="{StaticResource CardTitle}"/><TextBlock Text="Dönem özeti" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="Toplu ödeme görünümü" Style="{StaticResource CardSubtitle}"/></StackPanel></Border>
<Border Grid.Column="2" Style="{StaticResource CardCompact}" Margin="8,0,0,0"><StackPanel><TextBlock Text="SÖZLEŞME RAPORU" Style="{StaticResource CardTitle}"/><TextBlock Text="Sözleşme özeti" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="Temel sözleşme bilgileri" Style="{StaticResource CardSubtitle}"/></StackPanel></Border>
</Grid>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="RAPOR MERKEZİ" Style="{StaticResource CardTitle}"/><TextBlock Text="Hazır rapor şablonları veri katmanı bağlandıktan sonra aktif hale gelecek." Style="{StaticResource CardSubtitle}" Margin="0,0,0,16"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Grid.Column="0" Content="HAKEDİŞ RAPORU" Style="{StaticResource ModernButton}" Height="42" Margin="0,0,8,0"/><Button Grid.Column="1" Content="İCMAL RAPORU" Style="{StaticResource SecondaryButton}" Height="42" Margin="4,0"/><Button Grid.Column="2" Content="SÖZLEŞME RAPORU" Style="{StaticResource SecondaryButton}" Height="42" Margin="8,0,0,0"/></Grid></StackPanel></Border>
</StackPanel></Grid>

<Grid x:Name="SettingsPanel" Visibility="Collapsed"><StackPanel>
<TextBlock Text="AYARLAR" Style="{StaticResource PageTitle}"/><TextBlock Text="OEHS uygulamasının temel çalışma tercihlerini yönetin." Style="{StaticResource PageSubtitle}"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="UYGULAMA" Style="{StaticResource CardTitle}"/><TextBlock Text="Arayüz ve çalışma tercihleri" Style="{StaticResource CardSubtitle}" Margin="0,0,0,16"/><TextBlock Text="TEMA" Style="{StaticResource FieldLabel}"/><Border Background="#0A2A49" BorderBrush="#335A79" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,7,0,14"><TextBlock Text="OEHS Lacivert / Altın" Foreground="White" FontWeight="SemiBold"/></Border><TextBlock Text="PARA BİRİMİ" Style="{StaticResource FieldLabel}"/><Border Background="#0A2A49" BorderBrush="#335A79" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,7,0,0"><TextBlock Text="Türk Lirası (₺)" Foreground="White" FontWeight="SemiBold"/></Border></StackPanel></Border>
<Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0"><StackPanel><TextBlock Text="SİSTEM DURUMU" Style="{StaticResource CardTitle}"/><TextBlock Text="Uygulama altyapısı" Style="{StaticResource CardSubtitle}" Margin="0,0,0,16"/><Border Background="#0A2A49" CornerRadius="8" Padding="14" Margin="0,0,0,8"><StackPanel><TextBlock Text="HESAPLAMA MOTORU" Foreground="#91ABC0" FontSize="10" FontWeight="Bold"/><TextBlock Text="HAZIR" Foreground="{StaticResource Gold500Brush}" FontSize="17" FontWeight="Bold" Margin="0,3,0,0"/></StackPanel></Border><Border Background="#0A2A49" CornerRadius="8" Padding="14"><StackPanel><TextBlock Text="VERİ KATMANI" Foreground="#91ABC0" FontSize="10" FontWeight="Bold"/><TextBlock Text="GELİŞTİRİLİYOR" Foreground="{StaticResource Gold500Brush}" FontSize="17" FontWeight="Bold" Margin="0,3,0,0"/></StackPanel></Border></StackPanel></Border>
</Grid></StackPanel></Grid>

                        <Grid x:Name="PlaceholderPanel" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="PlaceholderTitleTextBlock" Text="Modül" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Bu bölüm sonraki geliştirme adımında aktif hale getirilecek." Style="{StaticResource PageSubtitle}"/>
                                <Border Background="#F7F9FC" BorderBrush="{StaticResource Line200Brush}" BorderThickness="1" CornerRadius="12" Padding="24">
                                    <TextBlock Text="Bu modül mevcut mimariye bağlanacak. Önce sözleşme → hatlar → hakediş akışının veri katmanı tamamlanıyor."
                                               TextWrapping="Wrap" FontSize="16" Foreground="{StaticResource Text600Brush}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Viewbox>
</Window>
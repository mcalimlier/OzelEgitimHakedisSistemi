<Application x:Class="OzelEgitimHakedis.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Gece Mavisi: ortak yüzey, giriş, tablo ve etkileşim renkleri -->
        <Color x:Key="Navy900">#061E32</Color>
        <Color x:Key="Navy950">#041726</Color>
        <Color x:Key="Blue600">#2468D8</Color>
        <Color x:Key="Blue700">#1756B8</Color>
        <Color x:Key="Gold500">#F4C45E</Color>
        <Color x:Key="Gold600">#D5AB56</Color>
        <Color x:Key="Danger500">#E53935</Color>
        <Color x:Key="Text900">#F0F6FC</Color>
        <Color x:Key="Text600">#B9CDDF</Color>
        <Color x:Key="Text700">#D5E4F1</Color>
        <Color x:Key="Line200">#466780</Color>
        <Color x:Key="Surface">#09283F</Color>

        <SolidColorBrush x:Key="Navy900Brush" Color="{StaticResource Navy900}"/>
        <SolidColorBrush x:Key="Navy950Brush" Color="{StaticResource Navy950}"/>
        <SolidColorBrush x:Key="Blue600Brush" Color="{StaticResource Blue600}"/>
        <SolidColorBrush x:Key="Blue700Brush" Color="{StaticResource Blue700}"/>
        <SolidColorBrush x:Key="Gold500Brush" Color="{StaticResource Gold500}"/>
        <SolidColorBrush x:Key="Gold600Brush" Color="{StaticResource Gold600}"/>
        <SolidColorBrush x:Key="Danger500Brush" Color="{StaticResource Danger500}"/>
        <SolidColorBrush x:Key="Text900Brush" Color="{StaticResource Text900}"/>
        <SolidColorBrush x:Key="Text600Brush" Color="{StaticResource Text600}"/>
        <SolidColorBrush x:Key="Text700Brush" Color="{StaticResource Text700}"/>
        <SolidColorBrush x:Key="Line200Brush" Color="{StaticResource Line200}"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}"/>

        <LinearGradientBrush x:Key="PremiumPanelBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#123952" Offset="0"/>
            <GradientStop Color="#0B2C44" Offset="0.58"/>
            <GradientStop Color="#071F33" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="PremiumInputBrush" Color="#082744"/>
        <SolidColorBrush x:Key="PremiumInputBorderBrush" Color="#365874"/>
        <SolidColorBrush x:Key="PremiumMutedTextBrush" Color="#B9CBDA"/>
        <SolidColorBrush x:Key="PremiumGoldBorderBrush" Color="#AD9054"/>

        <SolidColorBrush x:Key="NightTextBrush" Color="#F0F6FC"/>
        <SolidColorBrush x:Key="NightInkBrush" Color="#08223A"/>
        <SolidColorBrush x:Key="NightTableBrush" Color="#09283F"/>
        <SolidColorBrush x:Key="NightAlternateBrush" Color="#14374F"/>
        <SolidColorBrush x:Key="NightSelectionBrush" Color="#A8D8F2"/>
        <LinearGradientBrush x:Key="NightInputBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#264E69" Offset="0"/><GradientStop Color="#12354D" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="NightPrimaryBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#DDF4FF" Offset="0"/><GradientStop Color="#83CEE9" Offset="1"/>
        </LinearGradientBrush>
        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource Navy900Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource NightTextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource NightInputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource NightTextBrush}"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="#4286B1"/>
            <Setter Property="BorderBrush" Value="#5A7B94"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="7,0"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource NightInputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource NightTextBrush}"/>
            <Setter Property="BorderBrush" Value="#5A7B94"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MaxDropDownHeight" Value="320"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="Root">
                            <ToggleButton x:Name="DropToggle" Focusable="False" ClickMode="Press"
                                IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Frame" CornerRadius="6" BorderThickness="1"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                            <Path Data="M0,0 L5,5 L10,0" Stroke="#D4EBF8" StrokeThickness="1.5"
                                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#A8D8F2"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="SelectedContent" IsHitTestVisible="False" Margin="8,1,30,1"
                                VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                            <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" Margin="6,2,30,2"
                                Background="Transparent" Foreground="{TemplateBinding Foreground}" BorderThickness="0"
                                IsReadOnly="{TemplateBinding IsReadOnly}" VerticalContentAlignment="Center"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                                <Border Background="#09283F" BorderBrush="#5A7B94" BorderThickness="1" CornerRadius="6"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}" Padding="3">
                                    <ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True"><Setter TargetName="SelectedContent" Property="Visibility" Value="Hidden"/><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#A8D8F2"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Height" Value="32"/>
        </Style>

        <Style x:Key="StandardButtonBase" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ClickMode" Value="Release"/>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button" BasedOn="{StaticResource StandardButtonBase}">
            <Setter Property="Foreground" Value="{StaticResource NightInkBrush}"/>
            <Setter Property="Background" Value="{StaticResource NightPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.72"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ClickMode" Value="Release"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <Border x:Name="Accent" Width="4" HorizontalAlignment="Left" Background="Transparent"/>
                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Uid" Value="Active">
                                <Setter Property="Background" Value="#1D4E91"/>
                                <Setter TargetName="Accent" Property="Background" Value="{StaticResource Gold500Brush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#123B6C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubNavButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="24,0,8,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#E5EDF6"/>
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="19.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Text900Brush}"/>
            <Setter Property="Margin" Value="2,0,0,3"/>
        </Style>

        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource Text600Brush}"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Text900Brush}"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#D8E4EF"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="FieldTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="{StaticResource NightInputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource NightTextBrush}"/>
            <Setter Property="BorderBrush" Value="#5A7B94"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="33"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource Blue600Brush}"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PremiumPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PremiumPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PremiumGoldBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.25"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10.5"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="PremiumFieldTextBox" TargetType="TextBox" BasedOn="{StaticResource FieldTextBox}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- ============================================================
             OEHS DESIGN SYSTEM
             DoğruTemin görsel dili korunur; yeni projede tekrar kullanılabilir
             kart, liste, giriş, seçim, tarih ve durum bileşenleri.
             ============================================================ -->

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PremiumPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PremiumGoldBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.25"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="CardCompact" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <Style x:Key="PaymentWorkspaceCard" TargetType="Border" BasedOn="{StaticResource CardCompact}">
            <Setter Property="Background" Value="#0A223A"/>
            <Setter Property="BorderBrush" Value="#35546F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="CardSubtitle" TargetType="TextBlock" BasedOn="{StaticResource PageSubtitle}">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#C5D7E7"/>
        </Style>

        <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="8.5"/>
            <Setter Property="MinHeight" Value="74"/>
        </Style>

        <Style x:Key="StatusBanner" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource NightTableBrush}"/>
            <Setter Property="BorderBrush" Value="#466780"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="9,7"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource StandardButtonBase}">
            <Setter Property="Foreground" Value="{StaticResource NightTextBrush}"/>
            <Setter Property="Background" Value="{StaticResource NightInputBrush}"/>
            <Setter Property="BorderBrush" Value="#5A7B94"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#2C5C7C"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.78"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource Danger500Brush}"/>
        <Setter Property="Foreground" Value="White"/></Style>

        <Style x:Key="FieldComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Background" Value="{StaticResource NightInputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource NightTextBrush}"/>
            <Setter Property="BorderBrush" Value="#5A7B94"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="31"/>
            <Setter Property="Padding" Value="7,1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="FieldDatePicker" TargetType="DatePicker">
            <Setter Property="Background" Value="{StaticResource NightInputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource NightTextBrush}"/>
            <Setter Property="BorderBrush" Value="#5A7B94"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border x:Name="Frame" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                            <DatePickerTextBox x:Name="PART_TextBox" Background="Transparent" Foreground="{TemplateBinding Foreground}" BorderThickness="0" Padding="7,0" VerticalContentAlignment="Center"/>
                            <Button x:Name="PART_Button" Grid.Column="1" Focusable="False" ToolTip="Takvimi aç" Background="Transparent" BorderThickness="0" Padding="0" Height="Auto">
                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent"><TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" Foreground="#C8E4F5" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/></Border></ControlTemplate></Button.Template>
                            </Button>
                            <Popup x:Name="PART_Popup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#A8D8F2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>


        <Style x:Key="ValidationText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Gold500Brush}"/>
            <Setter Property="Margin" Value="5,5,5,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="3"/>
        </Style>

        <Style x:Key="PremiumCheckBox" TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid MinHeight="32">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    CornerRadius="6" Background="#123B5E" BorderBrush="#6F8DA7" BorderThickness="2"/>
                            <Path x:Name="CheckMark" Grid.Column="0" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="{StaticResource Gold500Brush}" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 2,8 L 6,12 L 14,3" Visibility="Collapsed"/>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#173F67"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Gold500Brush}"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Gold500Brush}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.55"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LightCheckBox" TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text900Brush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid MinHeight="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box"
                                    Width="22" Height="22"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    CornerRadius="6"
                                    Background="White"
                                    BorderBrush="#8CA5BD"
                                    BorderThickness="2"/>
                            <Path x:Name="CheckMark"
                                  Grid.Column="0"
                                  Width="14" Height="14"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Stroke="White"
                                  StrokeThickness="2.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M 2,7 L 6,11 L 13,3"
                                  Visibility="Collapsed"/>
                            <ContentPresenter Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Margin="8,0,0,0"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Blue600Brush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Blue600Brush}"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Blue700Brush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InfoNote" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource NightTableBrush}"/>
            <Setter Property="BorderBrush" Value="#466780"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="7,5"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource NightTextBrush}"/>
            <Setter Property="Background" Value="{StaticResource NightInputBrush}"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#245675"/>
                    <Setter Property="Foreground" Value="{StaticResource NightTextBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#A8D8F2"/><Setter Property="Foreground" Value="#08223A"/>
                    <Setter Property="Foreground" Value="{StaticResource NightTextBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernListBox" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="Background" Value="{StaticResource NightTableBrush}"/>
            <Setter Property="BorderBrush" Value="#466780"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Text900Brush}"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Margin" Value="1.5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#173C56"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#547B96"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#A8D8F2"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#79B8DC"/>
                                <Setter Property="Foreground" Value="{StaticResource NightInkBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PremiumListBox" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="Background" Value="{StaticResource PremiumInputBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PremiumInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style x:Key="PremiumListBoxItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#123B5C"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1D4E91"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Gold500Brush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernDataGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource NightInputBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#284660"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Height" Value="32"/>
        </Style>

        <Style x:Key="ModernDataGridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource NightTableBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource Text900Brush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="BorderBrush" Value="#294D67"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource NightSelectionBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource NightInkBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernDataGridCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/><Setter Property="Background" Value="Transparent"/></Style>

        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource NightTableBrush}"/>
            <Setter Property="BorderBrush" Value="#466780"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#294D67"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource ModernDataGridHeader}"/>
            <Setter Property="RowStyle" Value="{StaticResource ModernDataGridRow}"/>
            <Setter Property="CellStyle" Value="{StaticResource ModernDataGridCell}"/>
        <Setter Property="Foreground" Value="{StaticResource NightTextBrush}"/><Setter Property="RowBackground" Value="{StaticResource NightTableBrush}"/><Setter Property="AlternatingRowBackground" Value="{StaticResource NightAlternateBrush}"/></Style>

        <Style x:Key="GridCellText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridCellTextWrap" TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="GridCellEditTextBox" TargetType="TextBox" BasedOn="{StaticResource FieldTextBox}">
            <Setter Property="Height" Value="33"/>
            <Setter Property="Padding" Value="7,0"/>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"/>
        <Style TargetType="DataGrid" BasedOn="{StaticResource ModernDataGrid}"/>
        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernDataGridHeader}"/>
        <Style TargetType="DataGridRow" BasedOn="{StaticResource ModernDataGridRow}"/>
        <Style TargetType="DataGridCell" BasedOn="{StaticResource ModernDataGridCell}"/>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#14374F"/><Setter Property="Foreground" Value="#F0F6FC"/>
            <Setter Property="BorderBrush" Value="#5A7B94"/><Setter Property="Padding" Value="10,7"/>
        </Style>
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#F0F6FC"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12"/><Setter Property="Background" Value="#081F33"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"
                                Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.DecreaseRepeatButton><RepeatButton x:Name="Decrease" Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Grip" Background="#527993" CornerRadius="4" Margin="2"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#96C7E1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton x:Name="Increase" Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="12"/><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="Decrease" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="Increase" Property="Command" Value="ScrollBar.PageRightCommand"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
